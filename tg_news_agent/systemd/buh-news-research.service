[Unit]
Description=BUH.SK daily news research
Requires=buh-news-agent.service
After=network-online.target buh-news-agent.service

[Service]
Type=oneshot
User=buhnews
WorkingDirectory=/opt/buh_sk_news_bot/tg_news_agent
EnvironmentFile=/opt/buh_sk_news_bot/tg_news_agent/.env
ExecStart=/opt/buh_sk_news_bot/tg_news_agent/deploy/ubuntu/run-research.sh

