# Required for the standalone approval bot. Never commit real values.
# Preferred name; NEWS_TELEGRAM_BOT_TOKEN is a legacy fallback only.
SEPARATE_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_USER_ID=
OWNER_TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
NEWS_DATA_DIR=./data

# Public publication stays blocked with these safe defaults.
NEWS_MODE=preview
PUBLISHING_ENABLED=false
PRODUCTION_CHANNEL_ID=@buh_sk_ua
TEST_CHANNEL_ID=
TIMEZONE=Europe/Bratislava
MAX_CANDIDATES_PER_RUN=30
MAX_SEARCH_QUERIES_PER_RUN=6
MAX_FULL_ARTICLES_PER_RUN=3
MAX_NEW_DRAFTS_PER_DAY=1
APPROVAL_EXPIRY_HOURS=24
MAX_AI_REVISIONS_PER_DRAFT=2
MONTHLY_AI_BUDGET_USD=5.00
RECENT_TOPIC_HISTORY_DAYS=90
OPENAI_RANKING_MODEL=gpt-5.4-nano
OPENAI_WRITING_MODEL=gpt-5.4-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# Populate only after verifying current model pricing for your API account.
PRICE_TABLE_VERIFIED_ON=
RANKING_INPUT_USD_PER_1M=
RANKING_OUTPUT_USD_PER_1M=
WRITING_INPUT_USD_PER_1M=
WRITING_OUTPUT_USD_PER_1M=
SEARXNG_URL=
USER_AGENT=BUH.SK news research bot/1.0 (+https://buh.sk/)
LOG_LEVEL=INFO

# Daily worker success ping. Keep the real UUID URL only in .env.
HEALTHCHECKS_PING_URL=
